<?xml version='1.0' encoding='utf-8'?>
<launch>
  <arg name="jaws" default="solid" doc="solid, fin_ray" />
  <param name="robot_description" command="python3 &quot;$(find ssg48_description)/scripts/ros_urdf.py&quot; &quot;$(find ssg48_description)/ssg48_$(arg jaws).urdf&quot; --package ssg48_description" />
  <node pkg="joint_state_publisher_gui" type="joint_state_publisher_gui" name="joint_state_publisher_gui" />
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" />
  <node pkg="rviz" type="rviz" name="rviz" />
</launch>
<robot name="parol6_pneumatic">
  <virtual_joint name="world_joint" type="fixed" parent_frame="world" child_link="base_link" />
  <group name="arm">
    <chain base_link="base_link" tip_link="tcp" />
  </group>
  <group name="gripper">
    <joint name="left_finger_joint" />
    <joint name="right_finger_joint" />
  </group>
  <end_effector name="gripper" parent_link="tcp" group="gripper" parent_group="arm" />
  <group_state name="home" group="arm">
    <joint name="base_joint" value="0.0" />
    <joint name="shoulder_joint" value="0.0" />
    <joint name="elbow_joint" value="0.0" />
    <joint name="wrist_1_joint" value="0.0" />
    <joint name="wrist_2_joint" value="0.0" />
    <joint name="wrist_3_joint" value="0.0" />
  </group_state>
  <group_state name="ready" group="arm">
    <joint name="base_joint" value="0.0" />
    <joint name="shoulder_joint" value="-0.4" />
    <joint name="elbow_joint" value="0.6" />
    <joint name="wrist_1_joint" value="0.0" />
    <joint name="wrist_2_joint" value="0.5" />
    <joint name="wrist_3_joint" value="0.0" />
  </group_state>
  <group_state name="open" group="gripper">
    <joint name="left_finger_joint" value="0.0035" />
  </group_state>
  <group_state name="closed" group="gripper">
    <joint name="left_finger_joint" value="0.0" />
  </group_state>
  <disable_collisions link1="base_link" link2="shoulder_link" reason="Adjacent" />
  <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent" />
  <disable_collisions link1="upper_arm_link" link2="forearm_link" reason="Adjacent" />
  <disable_collisions link1="forearm_link" link2="wrist_1_link" reason="Adjacent" />
  <disable_collisions link1="wrist_1_link" link2="wrist_2_link" reason="Adjacent" />
  <disable_collisions link1="wrist_2_link" link2="pneumatic_gripper_link" reason="Adjacent" />
  <disable_collisions link1="pneumatic_gripper_link" link2="left_finger_link" reason="Adjacent" />
  <disable_collisions link1="pneumatic_gripper_link" link2="right_finger_link" reason="Adjacent" />
</robot>
